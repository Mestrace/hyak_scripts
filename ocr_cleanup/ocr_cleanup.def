Bootstrap: docker
From: ghcr.io/ggml-org/llama.cpp:server

%arguments
    NETID=default_user

%help
    This image provides the llama-server environment along with Python 3.12
    for OCR cleanup on CPU nodes (optimized for AMD/Intel via generic builds).

%post
    export DEBIAN_FRONTEND=noninteractive

    # Install prerequisites
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg \
        wget \
        git \
        bc \
        python3-dev \
        python3-pip

    # Install Python dependencies
    python3 -m pip install --no-cache-dir --break-system-packages \
        "openai>=1.0.0" \
        "pydantic>=2.0.0" \
        "httpx" \
        "huggingface_hub"

    # Cleanup
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export NETID={{ NETID }}
    export SCRIPTS_DIR=/mmfs1/gscratch/stf/{{ NETID }}/hyak_scripts/ocr_cleanup
    export HF_HOME=/mmfs1/gscratch/stf/{{ NETID }}/.cache/huggingface
    export LD_LIBRARY_PATH="/app:/app/lib:/usr/local/lib:$LD_LIBRARY_PATH"
    export PATH=/app:/usr/local/bin:$PATH

%labels
    Author Mestrace
    Version 4.0
    Description llama-server + Python 3.12 (Generic/AMD Optimized)
    NetID {{ NETID }}
