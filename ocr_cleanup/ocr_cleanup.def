Bootstrap: docker
From: ghcr.io/ggml-org/llama.cpp:server-intel

%arguments
    NETID=default_user

%help
    This image provides the llama-server environment along with Python 3.12
    for running OCR cleanup scripts.

    Arguments:
    - NETID: Your UW NetID (used for gscratch/stf paths).

%post
    export DEBIAN_FRONTEND=noninteractive

    # Consolidate package installation
    apt-get update && apt-get install -y --no-install-recommends \
        curl \
        git \
        bc \
        ca-certificates \
        python3-dev \
        python3-pip

    # Install Python dependencies
    python3 -m pip install --no-cache-dir --break-system-packages \
        "openai>=1.0.0" \
        "pydantic>=2.0.0" \
        "httpx" \
        "huggingface_hub"

    # Cleanup
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export NETID={{ NETID }}
    export SCRIPTS_DIR=/mmfs1/gscratch/stf/{{ NETID }}/hyak_scripts/ocr_cleanup
    export HF_HOME=/mmfs1/gscratch/stf/{{ NETID }}/.cache/huggingface
    export PATH=/usr/local/bin:$PATH

%labels
    Author Mestrace
    Version 3.4
    Description llama-server-intel + Python 3.12 for OCR Cleanup
    NetID {{ NETID }}
